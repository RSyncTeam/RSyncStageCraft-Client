<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Annotations only: tests moved from nullable-enabled projects keep their ? marks. -->
    <Nullable>annotations</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Debug only, as in the client: the human puppet host's tests. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);RSC_DEVELOPMENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Shared fixtures (the authentication fixture and actor host fakes) for the plugin tests. -->
    <InternalsVisibleTo Include="RSyncStageCraft.Plugin.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RSyncStageCraft.Client\RSyncStageCraft.Client.csproj" />
    <ProjectReference Include="..\RSyncStageCraft.Protocol.Tests\RSyncStageCraft.Protocol.Tests.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
